/dts-v1/;
#include <st/h5/stm32h5e5Xj.dtsi>
#include <st/h5/stm32h5e5zjtx-pinctrl.dtsi>
#include "arduino_r3_connector.dtsi"
#include "st_morpho_connector.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "STMicroelectronics STM32H5E5ZJ-NUCLEO board";
	compatible = "st,stm32h5e5zj-nucleo";

	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,sram = &sram1;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	leds: leds {
		compatible = "gpio-leds";

		green_led_1: led_1 {
			gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
			label = "User LD1";
		};

		red_led_2: led_2 {
			gpios = <&gpiof 0 GPIO_ACTIVE_LOW>;
			label = "User LD2";
		};

		blue_led_3: led_3 {
			gpios = <&gpioe 5 GPIO_ACTIVE_LOW>;
			label = "User LD3";
		};
	};

	pwmleds: pwmleds {
		compatible = "pwm-leds";
		/* NOTE: disabled by default, TIM5_CH4 reuses PA3 (green LED) */
		status = "disabled";

		pwm_led_1: green_pwm_led {
			pwms = <&pwm5 4 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "green led";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			label = "User";
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &green_led_1;
		led1 = &red_led_2;
		led2 = &blue_led_3;
		pwm-led0 = &pwm_led_1;
		sw0 = &user_button;
		rtc = &rtc;
		watchdog0 = &iwdg;
		die-temp0 = &die_temp;
		volt-sensor0 = &vref;
		volt-sensor1 = &vbat;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(48)>; /* X3 crystal */
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&clk_lse {
	status = "okay";
};

&clk_lsi {
	status = "okay";
};

&pll {
	div-m = <12>;
	mul-n = <125>;
	div-p = <2>;
	div-q = <5>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(250)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
	apb3-prescaler = <1>;
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pd8 &usart3_rx_pd9>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {
	pinctrl-0 = <&uart7_tx_pb4 &uart7_rx_pa8>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_scl_pf5 &i2c4_sda_pg6>;
	pinctrl-names = "default";
	scl-gpios = <&gpiof 5 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpiog 6 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&i3c1 {
	/* NOTE: disabled by default, I3C1 reuses the Arduino I2C pins */
	pinctrl-0 = <&i3c1_scl_pf5 &i3c1_sda_pg6>;
	pinctrl-names = "default";
	i3c-scl-hz = <12500000>;
	status = "disabled";
};

&spi4 {
	pinctrl-0 = <&spi4_sck_pe12 &spi4_miso_pe13 &spi4_mosi_pe14>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";
};

&timers5 {
	st,prescaler = <10000>;
	status = "okay";

	pwm5: pwm {
		status = "okay";
		pinctrl-0 = <&tim5_ch4_pa3>;
		pinctrl-names = "default";
	};
};

&adc12_common {
	st,adc-clock-source = "ASYNC";
	st,adc-prescaler = <6>;
	status = "okay";
};

&adc1 {
	/* Arduino A0, A1, A2, A3, A4, A5 */
	pinctrl-0 = <&adc1_inp3_pa6 &adc1_inp7_pa7 &adc1_inp18_pa4
		     &adc1_inp9_pb0 &adc1_inp6_pf12 &adc1_inp2_pf11>;
	pinctrl-names = "default";
	status = "okay";
};

&adc2 {
	status = "okay";
};

&adc3_common {
	st,adc-clock-source = "ASYNC";
	st,adc-prescaler = <6>;
	status = "okay";
};

&adc3 {
	/* Internal channels only: die temperature, VREFINT, VBAT and VDDCORE */
	status = "okay";
};

&dac1 {
	/* NOTE: disabled by default, DAC1_OUT1 reuses PA4 (Arduino A2) */
	pinctrl-0 = <&dac1_out1_pa4>;
	pinctrl-names = "default";
	status = "disabled";
};

&rtc {
	clocks = <&rcc STM32_CLOCK(APB3, 21)>,
		 <&rcc STM32_SRC_LSE RTC_SEL(1)>;
	status = "okay";
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};

&gpdma1 {
	status = "okay";
};

&gpdma2 {
	status = "okay";
};

&mac {
	pinctrl-0 = <&eth_rmii_ref_clk_pa1
		     &eth_rmii_tx_en_pa5
		     &eth_rmii_txd0_pb12
		     &eth_rmii_txd1_pg12
		     &eth_rmii_rxd0_pc4
		     &eth_rmii_rxd1_pc5
		     &eth_rmii_crs_dv_pd1>;
	pinctrl-names = "default";
	phy-connection-type = "rmii";
	phy-handle = <&eth_phy>;
	status = "okay";
};

&mdio {
	pinctrl-0 = <&eth_mdio_pa2 &eth_mdc_pc1>;
	pinctrl-names = "default";
	status = "okay";

	eth_phy: ethernet-phy@0 {
		compatible = "ethernet-phy";
		reg = <0x00>;
	};
};

&ucpd1 {
	/*
	 * UCPD is fed ucpd_ker_ck (HSI / 4) which is @ 16MHz. The ucpd_ker_ck goes to
	 * a prescaler who's output feeds the 'half-bit' divider which is used
	 * to generate clock for delay counters and BMC Rx/Tx blocks. The rx is
	 * designed to work in freq ranges of 6 <--> 18 MHz, however recommended
	 * range is 6 <--> 12 MHz (STM's HAL sets prescaler to /2 by default and
	 * hbit to /14)
	 *
	 *          +-------+ @ 8 MHz  +-------+   @ ~600 kHz   +-----------+
	 * HSI ---->| /psc  |--------->| /hbit |--------------->| trans_cnt |
	 *          +-------+          +-------+   |            +-----------+
	 *                                         |            +-----------+
	 *                                         +----------->| ifrgap_cnt|
	 *                                                      +-----------+
	 * Requirements:
	 *   1. hbit_clk ~= 600 kHz: 8 MHz / 600 kHz = 13.33
	 *   2. tTransitionWindow - 12 to 20 uSec
	 *   3. tInterframGap - >= 25 uSec
	 *
	 * hbit_clk = HSI / 4 / psc / hbit = 571.4 kHz = 1.751 uSec period
	 * tTransitionWindow = 1.751uS * 8 = 14 uS
	 * tInterFrameGap = 1.751 uS * 17 = 29.76 uS
	 */
	psc-ucpdclk = <2>;
	hbitclkdiv = <14>;
	pinctrl-0 = <&ucpd1_cc1_pb13 &ucpd1_cc2_pb14>;
	pinctrl-names = "default";
	status = "okay";
};

zephyr_udc0: &usbotg_hs {
	status = "okay";
};

&otghs_phy {
	/* HSE is 48MHz on this board: feed the PHY with HSE / 2 = 24MHz */
	clocks = <&rcc STM32_CLOCK(AHB2, 13)>,
		 <&rcc STM32_SRC_HSE OTGHS_SEL(2)>,
		 <&rcc STM32_SRC_HSE OTGPHYREFCK_SEL(10)>;
	clock-names = "gate", "mux", "fsel";
	status = "okay";
};

&vref {
	status = "okay";
};

&vbat {
	status = "okay";
};

&vddcore {
	status = "okay";
};

&die_temp {
	status = "okay";
};

&flash0 {
	partitions {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00010000 DT_SIZE_K(1984)>;
		};

		slot1_partition: partition@200000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00200000 DT_SIZE_K(1984)>;
		};

		storage_partition: partition@3f0000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x003f0000 DT_SIZE_K(64)>;
		};
	};
};
