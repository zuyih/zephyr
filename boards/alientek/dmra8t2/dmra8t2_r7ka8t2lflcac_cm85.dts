/dts-v1/;

#include <renesas/ra/ra8/r7ka8t2lflcac_cm85.dtsi>
#include "dmra8t2.dtsi"

/ {
	model = "Alientek ATK-DMRA8T2";
	compatible = "alientek,dmra8t2", "renesas,ra8t2", "renesas,ra8";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &code_mram_cm85;
		zephyr,flash-controller = &mram_ctrl;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,canbus = &canfd1;
		zephyr,crc = &crc;
		zephyr,entropy = &trng;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		sw0 = &key0;
		sw1 = &key1;
		sw2 = &boot_key;
	};
};

/* USB to serial converter (CH343P) on USB-C J3 */
&sci0 {
	interrupts = <0 1>, <1 1>, <2 1>, <3 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";
};

&uart0 {
	current-speed = <115200>;
	status = "okay";
};

/* HMI serial screen (CN3) / RS232, selected by jumper P1 */
&sci7 {
	interrupts = <4 1>, <5 1>, <6 1>, <7 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";
};

&uart7 {
	current-speed = <115200>;
	status = "okay";
};

/* RS485 (TP8485E) on CN2 */
&sci9 {
	interrupts = <8 1>, <9 1>, <10 1>, <11 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";
};

&uart9 {
	current-speed = <115200>;
	status = "okay";
};

/* ATK-MODULE header (CN2) */
&sci4 {
	interrupts = <12 1>, <13 1>, <14 1>, <15 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";
};

&uart4 {
	current-speed = <115200>;
	status = "okay";
};

/* SPI LCD / 2.4G wireless module header (U3) */
&spi0 {
	interrupts = <16 1>, <17 1>, <18 1>, <19 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";
};

/* Brought out on the encoder header CN11 (ENC3 = SCL, ENC4 = SDA) */
&iic2 {
	interrupts = <20 1>, <21 1>, <22 1>, <23 1>;
	interrupt-names = "rxi", "txi", "tei", "eri";
	status = "okay";
};

/* CAN-FD (TJA1050) on CN2 */
&canfd_global {
	interrupts = <24 1>, <25 1>;
	interrupt-names = "rxf", "glerr";
	status = "okay";

	canfd1 {
		interrupts = <26 1>, <27 1>, <28 11>;
		interrupt-names = "err", "tx", "rx";
		status = "okay";
	};
};

/* KEY0 = P707 (IRQ8), KEY1 = PD06 (IRQ18), BOOT = P201 (IRQ4) */
&port_irq8 {
	interrupts = <29 1>;
	status = "okay";
};

&port_irq18 {
	interrupts = <30 1>;
	status = "okay";
};

&port_irq4 {
	interrupts = <31 1>;
	status = "okay";
};

/* micro SD card socket */
&sdhc0 {
	interrupts = <32 1>, <33 1>, <34 1>;
	interrupt-names = "accs", "card", "dma-req";
	status = "okay";

	sdmmc {
		status = "okay";
	};
};

/* USB device on USB-C J4 */
&usbfs {
	interrupts = <35 12>, <36 12>;
	interrupt-names = "usbfs-i", "usbfs-r";
	status = "okay";

	zephyr_udc0: udc {
		status = "okay";
	};
};

&ulpt0 {
	interrupts = <37 1>;
	interrupt-names = "ulpti";
	status = "okay";

	timer {
		status = "okay";
	};
};

&ulpt1 {
	status = "okay";

	timer {
		status = "okay";
	};
};

/* Servo 1 pulse (SRV1) */
&pwm5 {
	interrupts = <39 1>, <40 1>;
	interrupt-names = "gtioca", "overflow";
	status = "okay";
};

/* Servo 2 pulse (SRV2) */
&pwm7 {
	interrupts = <41 1>, <42 1>;
	interrupt-names = "gtioca", "overflow";
	status = "okay";
};

/* Stepper driver pulse outputs: channel A = ST1_PUL, channel B = ST2_PUL */
&pwm11 {
	interrupts = <43 1>, <44 1>;
	interrupt-names = "gtioca", "overflow";
	status = "okay";
};

/* 32 MB SDRAM on the ATK-CNRA8T2 core module */
&sdram {
	status = "okay";
};

&sdram1 {
	status = "okay";
};

&crc {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&trng {
	status = "okay";
};

&code_mram_cm85 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x0 DT_SIZE_K(64)>;
		};

		slot0_partition: partition@10000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x10000 DT_SIZE_K(344)>;
		};

		slot1_partition: partition@66000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x66000 DT_SIZE_K(344)>;
		};

		storage_partition: partition@bc000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0xbc000 DT_SIZE_K(16)>;
		};
	};
};

&eswm {
	interrupts = <38 1>;
	interrupt-names = "gwdi";
	pinctrl-0 = <&ethphyclk_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* ENET0 - RJ45 J5 */
&eth0 {
	phy-connection-type = "mii";
	local-mac-address = [74 90 50 01 02 05];
	phy-clock-type = "xtal";
	phy-handle = <&phy1>;
	pinctrl-0 = <&eth0_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* ENET1 - RJ45 J6 */
&eth1 {
	phy-connection-type = "mii";
	local-mac-address = [74 90 50 01 02 06];
	phy-clock-type = "xtal";
	phy-handle = <&phy2>;
	pinctrl-0 = <&eth1_default>;
	pinctrl-names = "default";
	status = "okay";
};

/* Both YT8512C PHYs share the ET0 MDIO bus */
&mdio0 {
	pinctrl-0 = <&mdio0_default>;
	pinctrl-names = "default";
	mdio-hold-time-ns = <10>;
	mdio-capture-time-ns = <10>;
	status = "okay";

	phy1: phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		status = "okay";
	};

	phy2: phy@2 {
		compatible = "ethernet-phy";
		reg = <2>;
		status = "okay";
	};
};
