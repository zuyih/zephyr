#
# MCXC041 has only 2 KB of RAM. The defaults below are sized for that
# budget; applications that want serial console, multithreading, or a
# full libc must re-enable them explicitly in their prj.conf.
#

# Single-threaded by default: no main/idle stack, only the ISR stack.
CONFIG_MULTITHREADING=n

# Tight stack sizes (the only one that matters in single-thread mode is ISR).
CONFIG_ISR_STACK_SIZE=512
CONFIG_MAIN_STACK_SIZE=384
CONFIG_IDLE_STACK_SIZE=32

CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_GPIO=y
