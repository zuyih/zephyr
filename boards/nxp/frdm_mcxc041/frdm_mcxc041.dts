/dts-v1/;

#include <nxp/mcx/nxp_mcxc041.dtsi>
#include "frdm_mcxc041-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "NXP FRDM-MCXC041 board";
	compatible = "nxp,mcxc041", "nxp,mcx";

	aliases {
		led0 = &red_led;
		led1 = &green_led;
		led2 = &blue_led;
		pwm-led0 = &red_pwm_led;
		pwm-led1 = &green_pwm_led;
		pwm-led2 = &blue_pwm_led;
		red-pwm-led = &red_pwm_led;
		green-pwm-led = &green_pwm_led;
		blue-pwm-led = &blue_pwm_led;
		sw0 = &user_button_2;
		sw1 = &user_button_3;
		accel0 = &fxls8974;
		pwm-0 = &tpm1;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &lpuart0;
		zephyr,shell-uart = &lpuart0;
	};

	leds {
		compatible = "gpio-leds";

		red_led: led_0 {
			gpios = <&gpiob 10 GPIO_ACTIVE_LOW>;
			label = "Red LED";
		};

		green_led: led_1 {
			gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
			label = "Green LED";
		};

		blue_led: led_2 {
			gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
			label = "Blue LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		status = "disabled";

		red_pwm_led: pwm_led_0 {
			pwms = <&tpm0 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "PWM Red LED";
		};

		green_pwm_led: pwm_led_1 {
			pwms = <&tpm0 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "PWM Green LED";
		};

		blue_pwm_led: pwm_led_2 {
			pwms = <&tpm1 1 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
			label = "PWM Blue LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button_2: button_2 {
			label = "User SW2";
			gpios = <&gpiob 0 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};

		user_button_3: button_3 {
			label = "User SW3";
			gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&sim {
	/*
	 * MCXC041 uses MCG-Lite and has no PLL. The binding requires
	 * pllfll-select to be set, but the SoC's clock_init() doesn't
	 * actually consume it for MCG-Lite parts. Use IRC48MHZ to reflect
	 * the fact that HIRC (48 MHz) is what the system actually runs on.
	 */
	pllfll-select = <KINETIS_SIM_PLLFLLSEL_IRC48MHZ>;
	er32k-select = <KINETIS_SIM_ER32KSEL_OSC32KCLK>;
};

&cpu0 {
	clock-frequency = <DT_FREQ_M(48)>;
};

&osc {
	clock-frequency = <32768>;
	mode = "low-power";
};

&gpioa {
	status = "okay";
};

&gpiob {
	status = "okay";
};

&lpuart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_lpuart0>;
	pinctrl-names = "default";
};

i2c0: &i2c0 {
	status = "okay";
	pinctrl-0 = <&pinmux_i2c0>;
	pinctrl-names = "default";

	fxls8974: fxls8974@18 {
		status = "okay";
		compatible = "nxp,fxls8974";
		reg = <0x18>;
	};
};

&tpm0 {
	status = "okay";
	pinctrl-0 = <&pinmux_tpm0>;
	pinctrl-names = "default";
};

&tpm1 {
	status = "okay";
	pinctrl-0 = <&pinmux_tpm1>;
	pinctrl-names = "default";
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&pinmux_adc0>;
	pinctrl-names = "default";
};

&lptmr0 {
	status = "okay";
};

&rtc {
	status = "okay";
};

&cmp {
	status = "okay";
	pinctrl-0 = <&pinmux_cmp>;
	pinctrl-names = "default";
};

&vref {
	status = "okay";
};
